<?xml version="1.0" encoding="UTF-8" ?>
<configuration>
    <appender name="stdout_humanreadable" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>
                %d{dd-MM-yyyy HH:mm:ss.SSS} %magenta([%thread]) %highlight(%-5level) %logger{36}.%M - %msg%n
            </pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="stdout_humanreadable"/>
    </root>
</configuration>
